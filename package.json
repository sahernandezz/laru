    "laru": "node apps/cli/src/main.ts",
    "build": "pnpm --filter @laru/web build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2"
